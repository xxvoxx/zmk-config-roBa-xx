#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define SNIPE 6

/* ホールドタップの基本設定 */
&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    tapping-term-ms = <300>;
};

&sl { release-after-ms = <180>; };

/ {
    /* 
       【今度こそ大本命の設定】
       レイヤー5（SCROLL）にいる間だけ、トラックボールの「上下の移動（Y軸）」を
       マウス移動ではなく、キーボードの「RIGHT（右矢印）」と「LEFT（左矢印）」の信号へ
       完全に内部で翻訳して連打出力する、ZMK標準のリスナー定義です。
    */
    p_alt_tab_input {
        compatible = "zmk,input-behavior-listener";
        device = <&pd0>; // roBaの右側トラックボールのセンサーを指定
        layers = <5>;    // レイヤー5（SCROLL）にいるときだけこの機能をONにする
        evt-type = <INPUT_EV_REL>;
        code = <INPUT_REL_Y>; // トラックボールの「上下」の動きをトリガーにする
        scale-multiplier = <1>;
        scale-divisor = <40>; // コロコロしたときの連打の速さを適正に調整
        bindings = <&ib_kp RIGHT LEFT>; // 上に転がすと右矢印、下に転がすと左矢印
    };

    combos {
        compatible = "zmk,combos";

        op {
            bindings = <&kp MINUS>;
            key-positions = <9 8>;
        };

        single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <21 20>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <32 33>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 10>;
        };

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <35 36>;
        };

        brackets {
            bindings = <&brackets>;
            key-positions = <7 6>;
        };

        braces {
            bindings = <&braces>;
            key-positions = <19 18>;
        };

        parenthesis {
            bindings = <&parenthesis>;
            key-positions = <31 30>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        brackets: brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "BRACKETS";
        };

        braces: braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT>;
            label = "BRACES";
        };

        parenthesis: parthens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
            label = "PARTHENS";
        };

        lgts: lgts {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN &kp GREATER_THAN &kp LEFT>;
            label = "LGTS";
        };

        cmd_space: cmd_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
            label = "CMD_SPACE";
        };

        bracket: bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp LEFT_BRACKET>;
            label = "BRACKET";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(NUMBER_4))>;
            label = "SCREENSHOT";
        };

        macro_left_click: macro_left_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp LCLK>,
                <&macro_tap>,
                <&tog_off 4 &sl 4>;

            label = "MACRO_LEFT_CLICK";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        /* 長押し中だけLayer 5（SCROLLベースのカスタム）を起動するホールドタップ */
        alt_tab_hold: alt_tab_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "ALT_TAB_HOLD";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&none>;
        };

        /* インプットリスナー用のキーコード変換ビヘイビア */
        ib_kp: ib_kp {
            compatible = "zmk,behavior-input-two-param";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W     &kp E         &kp R             &kp T                                                 &kp Y        &kp U  &kp I      &kp O       &kp P
&kp A             &kp S     &kp D         &kp F             &kp G      &alt_tab_hold 5 0           &kp K_APP      &kp H        &kp J  &kp K      &kp L       &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X     &kp C         &kp V             &kp B      &kp A                       &kp DEL        &kp N        &kp M  &kp COMMA  &kp PERIOD  &mt RIGHT_SHIFT SLASH
&kp LEFT_CONTROL  &kp LWIN  &kp LEFT_ALT  &lt 3 LANGUAGE_2  &kp SPACE  &lt 1 LANG1                 &kp BACKSPACE  &lt 2 ENTER                                &kp ESC
            >;
        };

        SYM {
            bindings = <
&bt BT_CLR_ALL   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3                                   &kp HOME      &kp END               &trans                 &kp PAGE_UP     &kp PAGE_DOWN
&kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6      &kp NUMBER_7   &kp NUMBER_8  &kp NUMBER_9          &kp NUMBER_0           &kp MINUS       &kp EQUAL
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT   &kp CARET         &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE  &kp PLUS
&trans           &trans        &trans        &trans        &trans        &trans            &trans         &trans                                                                     &trans
            >;
        };

        NUM_BLE {
            bindings = <
&trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_EQUAL                               &kp HOME       &kp END   &trans    &trans     &trans
&trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MULTIPLY  &kp KP_PLUS       &trans  &kp PAGE_UP    &mkp MB1  &kp UP    &mkp MB2   &trans
&trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_SLASH     &kp KP_MINUS      &trans  &kp PAGE_DOWN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans
&trans  &kp KP_NUMBER_0  &kp KP_DOT       &trans           &trans           &trans            &trans  &trans                                        &trans
            >;
        };

        FUNCTION {
            bindings = <
&trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_EQUAL                               &none   &none   &none    &none    &none
&trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MULTIPLY  &kp KP_PLUS       &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_SLASH     &kp KP_MINUS      &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6
&trans  &kp KP_NUMBER_0  &kp KP_DOT       &trans           &trans           &trans            &trans  &trans                                        &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans             &mo 6   &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &macro_left_click  &mo 5   &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans             &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                       &trans
            >;
        };

        /* Layer 5 (SCROLLベースのカスタム): 
           このレイヤーに入ると、インプットリスナーによりトラックボールの物理的な「移動信号」が
           パソコンに届く前にすべて「右矢印」「左矢印」のキー連打へと完全に差し替えられます。
           同時に背景の LALT により、Altがホールド状態になります。 */
        SCROLL {
            bindings = <
&kp LALT  &kp LALT  &kp LALT  &kp LALT  &kp LALT                                &kp LALT  &kp LALT  &kp LALT  &kp LALT  &kp LALT
&kp LALT  &kp LALT  &kp LALT  &kp LALT  &kp LALT  &trans              &trans    &kp LALT  &kp LALT  &kp LALT  &kp LALT  &kp LALT
&kp LALT  &kp LALT  &kp LALT  &kp LALT  &kp LALT  &trans              &trans    &kp LALT  &kp LALT  &kp LALT  &kp LALT  &kp LALT
&trans    &trans    &trans    &trans    &trans    &trans              &trans    &trans                                  &trans
            >;
        };

        SNIPE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans             &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &macro_left_click  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans             &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                       &trans
